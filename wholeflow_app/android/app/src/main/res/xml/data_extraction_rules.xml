<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing of the app's data goes to cloud backup or to a new
     phone. The login session lives in shared preferences, and a copied session
     would sign the new phone in without a password. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>

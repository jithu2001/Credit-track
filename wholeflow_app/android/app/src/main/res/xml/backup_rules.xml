<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older (allowBackup is also false): keep the login session
     and app data out of any backup. -->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="root" path="." />
</full-backup-content>

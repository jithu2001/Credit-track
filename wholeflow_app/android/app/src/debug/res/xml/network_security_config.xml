<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: plain HTTP to this phone's own 127.0.0.1, which
     `adb reverse` forwards to a WholeFlow server running on the developer's
     computer (local testing). Release builds keep Android's default (HTTPS only). -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>

# Copy to .env and adjust. Real environment variables override this file.
# wholeflow.exe reads it from its working directory, from the exe directory and
# from the data directory (%ProgramData%\WholeFlow). Never commit a real .env.

# ----------------------------------------------------------------- TallyPrime (shared)

# Where TallyPrime's HTTP/XML server listens.
TALLY_HOST=localhost
# Leave empty to read "ServerPort" from tally.ini (C:\Program Files\TallyPrime\tally.ini).
# In TallyPrime: Help (F1) > Settings > Connectivity > Client/Server configuration.
TALLY_PORT=
# TALLY_INI=C:\Program Files\TallyPrime\tally.ini
# Default 180 s: a first full voucher fetch of a large company can take 10-20 s.
TALLY_TIMEOUT_SECONDS=

# Tally groups whose ledgers are "shops" (sub-groups included). Comma-separated.
SHOP_GROUPS=Sundry Debtors
# Tally groups whose ledgers are suppliers (Suppliers page). Comma-separated.
SUPPLIER_GROUPS=Sundry Creditors

# ----------------------------------------------------------------- Web app

# Optional: company to use when the browser doesn't pick one.
TALLY_COMPANY=
# Keep it on 127.0.0.1 unless other PCs must reach the dashboards. The Cloud
# Sync page and its API always answer only to localhost, whatever this says.
APP_ADDR=127.0.0.1:8080
# Where config.json, state.json and logs live. Default: %ProgramData%\WholeFlow
# WHOLEFLOW_DATA_DIR=C:\ProgramData\WholeFlow
# Log directory. Default: <data dir>\logs
LOG_DIR=
# Development only: save every raw Tally XML response (contains accounting data) to logs/raw.
TALLY_DEBUG_RAW=false

# ----------------------------------------------------------------- Cloud sync
# Everything below can also be set on the app's Cloud Sync page
# (http://127.0.0.1:8080/#/sync) and is then stored in config.json with the
# key encrypted (DPAPI). Values set here OVERRIDE the config file and are never
# written to it.

# supabase (default) or memory (dry run: nothing leaves this PC).
CLOUD_PROVIDER=supabase
SUPABASE_URL=
# Service-role key: server-side only. NEVER put it in the mobile app or any client code.
SUPABASE_SERVICE_ROLE_KEY=

# UUID of the row in the businesses table this PC belongs to.
BUSINESS_ID=
BUSINESS_NAME=

# How often to synchronise, in seconds (60-86400). 300 = 5 minutes.
SYNC_INTERVAL_SECONDS=300
# Synchronise vouchers/transactions as well as shops and balances.
SYNC_TRANSACTIONS=true
# Suppliers, purchase bills (with item lines) and stock items (need migration 0003). Default on.
SYNC_SUPPLIERS=
SYNC_PURCHASES=
SYNC_INVENTORY=
# Background synchronisation on/off (also toggled in the UI).
SYNC_ENABLED=
# Comma-separated Tally company GUIDs to enable without using the UI (headless setups).
SYNC_COMPANIES=

# Admin account that unlocks the whole app (development convenience only). In
# production run
#   wholeflow.exe set-password
# which stores a salted PBKDF2 hash. Default username "admin"; no default password.
DEVELOPER_USERNAME=
DEVELOPER_PASSWORD=

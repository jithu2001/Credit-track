# /opt/wholeflow/control.env — read by systemd (wholeflow-control.service). chmod 600. Never commit.
# Same password as POSTGRES_PASSWORD in .env.
CONTROL_DB_URL=postgres://postgres:CHANGE-ME@127.0.0.1:5432/control_db
PG_ADMIN_URL=postgres://postgres:CHANGE-ME@127.0.0.1:5432/postgres
# Encrypts each business's secrets in control_db: openssl rand -hex 32. Keep a safe copy;
# losing it means the stored business keys can no longer be read.
MASTER_KEY=
# Same value as INTERNAL_TOKEN in .env (openssl rand -hex 32).
INTERNAL_TOKEN=
PUBLIC_URL=https://api.example.in
KIT_DIR=/opt/wholeflow
LISTEN=127.0.0.1:8100

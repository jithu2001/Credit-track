# /opt/wholeflow/control.env — read by systemd (wholeflow-control.service).
# Mode 600, owner root. Never commit.
# The control service provisions databases, so it uses the postgres superuser
# (same password as POSTGRES_PASSWORD in .env).
CONTROL_DB_URL=postgres://postgres:CHANGE-ME@127.0.0.1:5432/control_db
PG_ADMIN_URL=postgres://postgres:CHANGE-ME@127.0.0.1:5432/postgres
# Encrypts each business's secrets in control_db: openssl rand -hex 32. Keep a
# copy in your password manager: losing it means the stored business keys can
# no longer be read. The nightly backup's (encrypted) config bundle includes
# this file.
MASTER_KEY=
# LEGACY: shared secret for /control/internal/* (openssl rand -hex 32), used
# only by the old Deno staff service. Remove the line once that service is
# retired (docs/API_PLAN.md §5 step 12): the route then no longer exists.
# nginx never exposes /control/internal/.
INTERNAL_TOKEN=
PUBLIC_URL=https://api.example.in
KIT_DIR=/opt/wholeflow
LISTEN=127.0.0.1:8100

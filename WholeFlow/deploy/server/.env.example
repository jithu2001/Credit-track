# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me-long-random
# Public address of the API, e.g. https://api.example.in
PUBLIC_URL=https://api.example.in
# LEGACY: shared secret between the control service and the old staff service
# (openssl rand -hex 32), same value as INTERNAL_TOKEN in control.env. Remove
# both once the staff service is retired (docs/API_PLAN.md §5 step 12).
INTERNAL_TOKEN=change-me-64-hex-characters

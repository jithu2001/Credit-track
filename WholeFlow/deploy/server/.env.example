# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me-long-random
# Public address of the API, e.g. https://api.example.in
PUBLIC_URL=https://api.example.in
# Shared secret between the control service and the staff service (openssl rand -hex 32).
# Must be the same value as INTERNAL_TOKEN in control.env.
INTERNAL_TOKEN=change-me-64-hex-characters

# /opt/wholeflow/api.env — read by systemd for wholeflow-api.service.
# Mode 600, owner root (scripts/setup-users.sh sets it; systemd reads it as root
# before starting the service as user wholeflow-api). Never commit.

# control_db as the read-only role wholeflow_api_ro (db/api_ro_role.sql: SELECT
# on businesses and settings only), NOT the postgres superuser. Its password is
# set when that file is applied; URL-encode special characters.
CONTROL_DB_URL=postgres://wholeflow_api_ro:CHANGE-ME@127.0.0.1:5432/control_db
# Same value as MASTER_KEY in control.env (unseals each business's token secret).
MASTER_KEY=
KIT_DIR=/opt/wholeflow
PG_HOST=127.0.0.1:5432
LISTEN=127.0.0.1:8300

# Connection pools (see README "PostgreSQL capacity"). Defaults are in the API;
# uncomment to override.
# Data connections per business database:
# API_TENANT_MAX_CONNS=3
# Sign-in connections per business database:
# API_AUTH_MAX_CONNS=2
# The newest business-database migration (e.g. 0009_lockdown.sql); businesses
# behind it are logged as a warning. Empty = no check.
# API_EXPECTED_MIGRATION=

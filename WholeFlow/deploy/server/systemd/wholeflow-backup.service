[Unit]
Description=WholeFlow nightly backup to /opt/wholeflow/backup (see scripts/backup.sh)
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/wholeflow/scripts/backup.sh
# Dumps can take a while; never run into the next night.
TimeoutStartSec=3h
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

# /opt/wholeflow/backup.env — read by scripts/backup.sh, restore.sh and
# delete-business.sh. Mode 600, owner root. Never commit.

# Off-site copy: an rclone remote and path (configure the remote first with
# `rclone config`; its credentials live in /root/.config/rclone/rclone.conf).
# Recommended: a Backblaze B2 bucket with Object Lock (e.g. 30 days,
# governance or compliance mode) and a lifecycle rule deleting files after
# 90 days, and an application key limited to that bucket WITHOUT deleteFiles.
# The server only ever runs `rclone copy`; it never deletes remote files.
# Leave empty and monitor.sh logs "PROBLEM off-site copy not configured".
BACKUP_REMOTE=
# BACKUP_REMOTE=b2wf:wholeflow-backups/jitsuji

# Days of nightly backups kept on this server.
KEEP_DAYS=14
# Days the final backup of a deleted business is kept on this server.
FINAL_KEEP_DAYS=90
# 1 = include /etc/letsencrypt (certificates and their keys) in the encrypted
# config bundle; 0 = leave out (certbot can issue new ones).
BACKUP_LETSENCRYPT=1
